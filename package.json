{
  "name": "levix-digital-website",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "verify:dist": "node scripts/verify-prerender.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && vue-tsc --noEmit -p tooling/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "hosting:setup": "node scripts/hosting-setup.mjs",
    "deploy": "node scripts/hosting-deploy.mjs",
    "deploy:preview": "node scripts/hosting-deploy.mjs --channel",
    "verify:hosting": "firebase emulators:exec --only hosting --project levix-digital \"node scripts/verify-hosting.mjs\"",
    "lighthouse": "node scripts/lighthouse.mjs",
    "sites:changed": "node scripts/changed-sites.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-vue": "^10.12.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@lhci/cli": {
      "lighthouse": "13.5.0"
    }
  }
}
